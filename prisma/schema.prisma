generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PROVIDER
  CLINICAL_STAFF
  RECEPTIONIST
  BILLING
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  SIGNED
}

enum ChargeStatus {
  DRAFT
  POSTED
  VOIDED
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  VOIDED
}

enum PaymentSource {
  PATIENT
  INSURANCE
  OTHER
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  EFT
  OTHER
}

enum PaymentStatus {
  DRAFT
  POSTED
  VOIDED
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_ADJUDICATED
  ADJUDICATED
  VOIDED
}

enum EraImportStatus {
  RECEIVED
  VALIDATION_FAILED
  VALIDATED
  RECONCILIATION_READY
  RECONCILED
  POSTED
  VOIDED
}

enum EraMatchStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
  EXCEPTION
  RECONCILED
}

enum EraExceptionSeverity {
  INFO
  WARNING
  ERROR
}

enum EraExceptionStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum EraPostingBatchStatus {
  PREVIEW
  BLOCKED
  READY_FOR_REVIEW
  APPROVED
  POSTED
  REVERSED
}

enum EraAdjustmentTreatment {
  PATIENT_RESPONSIBILITY
  CONTRACTUAL_CREDIT
  CONTRACTUAL_DEBIT
  REVIEW_REQUIRED
  INFORMATIONAL
}

model Practice {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())

  users              User[]
  providers          Provider[]
  patients           Patient[]
  appointments       Appointment[]
  encounters         ClinicalEncounter[]
  auditEvents        AuditEvent[]
  encounterDiagnoses EncounterDiagnosis[]

  feeSchedules FeeSchedule[]
  charges      Charge[]
  adjustments  ChargeAdjustment[]
  payments     Payment[]

  insurancePayers       InsurancePayer[]
  insuranceClaims       InsuranceClaim[]
  eraImports            EraImport[]
  eraExceptions         EraException[]
  eraPostingBatches     EraPostingBatch[]
  eraAdjustmentMappings EraAdjustmentMapping[]
  eraPostingReversals   EraPostingReversal[]
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        Role
  active      Boolean  @default(true)
  practiceId  String
  createdAt   DateTime @default(now())

  practice          Practice             @relation(fields: [practiceId], references: [id])
  auditEvents       AuditEvent[]
  createdEncounters ClinicalEncounter[]  @relation("EncounterAuthor")
  authoredDiagnoses EncounterDiagnosis[] @relation("DiagnosisAuthor")

  createdCharges  Charge[] @relation("ChargeCreator")
  reviewedCharges Charge[] @relation("ChargeReviewer")
  postedCharges   Charge[] @relation("ChargePoster")
  voidedCharges   Charge[] @relation("ChargeVoider")

  createdAdjustments  ChargeAdjustment[] @relation("AdjustmentCreator")
  reviewedAdjustments ChargeAdjustment[] @relation("AdjustmentReviewer")
  postedAdjustments   ChargeAdjustment[] @relation("AdjustmentPoster")

  createdPayments  Payment[] @relation("PaymentCreator")
  reviewedPayments Payment[] @relation("PaymentReviewer")
  postedPayments   Payment[] @relation("PaymentPoster")

  importedEraFiles      EraImport[]    @relation("EraImporter")
  resolvedEraExceptions EraException[] @relation("EraExceptionResolver")

  preparedEraPostingBatches   EraPostingBatch[]    @relation("EraPostingPreparer")
  approvedEraPostingBatches   EraPostingBatch[]    @relation("EraPostingApprover")
  postedEraPostingBatches     EraPostingBatch[]    @relation("EraPostingPoster")
  reversedEraPostingBatches   EraPostingBatch[]    @relation("EraPostingReverser")
  reversedEraPostingReversals EraPostingReversal[] @relation("EraPostingReversalActor")
}

model Provider {
  id          String  @id @default(cuid())
  displayName String
  specialty   String
  credential  String
  active      Boolean @default(true)
  practiceId  String

  practice     Practice            @relation(fields: [practiceId], references: [id])
  appointments Appointment[]
  encounters   ClinicalEncounter[]
  charges      Charge[]
}

model Patient {
  id          String   @id @default(cuid())
  mrn         String   @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String
  status      String   @default("ACTIVE")
  practiceId  String
  createdAt   DateTime @default(now())

  practice     Practice            @relation(fields: [practiceId], references: [id])
  appointments Appointment[]
  encounters   ClinicalEncounter[]
  charges      Charge[]
  adjustments  ChargeAdjustment[]
  payments     Payment[]

  insuranceClaims  InsuranceClaim[]
  eraClaims        EraClaim[]
  eraPostingClaims EraPostingClaim[]

  @@index([practiceId, lastName, firstName])
}

model Appointment {
  id          String            @id @default(cuid())
  startsAt    DateTime
  durationMin Int               @default(30)
  visitType   String
  status      AppointmentStatus @default(SCHEDULED)
  patientId   String
  providerId  String
  practiceId  String
  createdAt   DateTime          @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  practice Practice @relation(fields: [practiceId], references: [id])

  encounter ClinicalEncounter?

  @@index([practiceId, startsAt])
}

model ClinicalEncounter {
  id            String          @id @default(cuid())
  appointmentId String          @unique
  patientId     String
  providerId    String
  practiceId    String
  authorId      String?
  status        EncounterStatus @default(DRAFT)

  chiefComplaint          String? @db.Text
  historyOfPresentIllness String? @db.Text
  reviewOfSystems         String? @db.Text
  physicalExam            String? @db.Text
  assessment              String? @db.Text
  diagnosis               String? @db.Text
  plan                    String? @db.Text

  vitals Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  signedAt  DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  provider    Provider    @relation(fields: [providerId], references: [id])
  practice    Practice    @relation(fields: [practiceId], references: [id])
  author      User?       @relation("EncounterAuthor", fields: [authorId], references: [id])

  diagnoses EncounterDiagnosis[]
  charge    Charge?

  @@index([practiceId, status])
  @@index([patientId, createdAt])
  @@index([providerId, createdAt])
}

model DiagnosisCode {
  id           String    @id @default(cuid())
  code         String
  description  String    @db.Text
  fiscalYear   Int
  billable     Boolean   @default(false)
  validFrom    DateTime
  validThrough DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  encounterDiagnoses EncounterDiagnosis[]

  @@unique([code, fiscalYear])
  @@index([fiscalYear, code])
  @@index([fiscalYear, description])
}

model EncounterDiagnosis {
  id              String   @id @default(cuid())
  encounterId     String
  diagnosisCodeId String
  sequence        Int
  practiceId      String
  addedById       String?
  createdAt       DateTime @default(now())

  encounter     ClinicalEncounter @relation(fields: [encounterId], references: [id])
  diagnosisCode DiagnosisCode     @relation(fields: [diagnosisCodeId], references: [id])
  practice      Practice          @relation(fields: [practiceId], references: [id])
  addedBy       User?             @relation("DiagnosisAuthor", fields: [addedById], references: [id])

  @@unique([encounterId, diagnosisCodeId])
  @@unique([encounterId, sequence])
  @@index([practiceId, encounterId])
  @@index([diagnosisCodeId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actorId    String?
  practiceId String

  actor    User?    @relation(fields: [actorId], references: [id])
  practice Practice @relation(fields: [practiceId], references: [id])

  @@index([practiceId, createdAt])
}

model ProcedureCode {
  id               String   @id @default(cuid())
  code             String   @unique
  description      String   @db.Text
  category         String
  visitTypeMapping String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  feeScheduleItems FeeScheduleItem[]
  chargeLines      ChargeLine[]

  @@index([isActive, category])
}

model FeeSchedule {
  id               String    @id @default(cuid())
  name             String
  currency         String    @default("USD") @db.VarChar(3)
  effectiveFrom    DateTime
  effectiveThrough DateTime?
  isActive         Boolean   @default(true)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  items   FeeScheduleItem[]
  charges Charge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, isActive])
  @@index([practiceId, effectiveFrom, effectiveThrough])
}

model FeeScheduleItem {
  id              String   @id @default(cuid())
  feeScheduleId   String
  procedureCodeId String
  unitPrice       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  feeSchedule   FeeSchedule   @relation(fields: [feeScheduleId], references: [id])
  procedureCode ProcedureCode @relation(fields: [procedureCodeId], references: [id])

  chargeLines ChargeLine[]

  @@unique([feeScheduleId, procedureCodeId])
  @@index([procedureCodeId])
}

model Charge {
  id            String  @id @default(cuid())
  encounterId   String  @unique
  patientId     String
  providerId    String
  practiceId    String
  feeScheduleId String?

  status      ChargeStatus @default(DRAFT)
  currency    String       @default("USD") @db.VarChar(3)
  subtotal    Decimal      @db.Decimal(12, 2)
  totalAmount Decimal      @db.Decimal(12, 2)

  createdById  String
  reviewedById String?
  postedById   String?
  voidedById   String?

  generatedAt DateTime  @default(now())
  reviewedAt  DateTime?
  postedAt    DateTime?
  voidedAt    DateTime?

  notes String? @db.Text

  encounter   ClinicalEncounter @relation(fields: [encounterId], references: [id])
  patient     Patient           @relation(fields: [patientId], references: [id])
  provider    Provider          @relation(fields: [providerId], references: [id])
  practice    Practice          @relation(fields: [practiceId], references: [id])
  feeSchedule FeeSchedule?      @relation(fields: [feeScheduleId], references: [id])

  createdBy  User  @relation("ChargeCreator", fields: [createdById], references: [id])
  reviewedBy User? @relation("ChargeReviewer", fields: [reviewedById], references: [id])
  postedBy   User? @relation("ChargePoster", fields: [postedById], references: [id])
  voidedBy   User? @relation("ChargeVoider", fields: [voidedById], references: [id])

  lines              ChargeLine[]
  adjustments        ChargeAdjustment[]
  paymentAllocations PaymentAllocation[]
  eraPostingItems    EraPostingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, status, generatedAt])
  @@index([patientId, generatedAt])
  @@index([providerId, generatedAt])
}

model ChargeLine {
  id                String  @id @default(cuid())
  chargeId          String
  procedureCodeId   String
  feeScheduleItemId String?

  sequence            Int
  codeSnapshot        String
  descriptionSnapshot String @db.Text

  units     Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  charge          Charge           @relation(fields: [chargeId], references: [id])
  procedureCode   ProcedureCode    @relation(fields: [procedureCodeId], references: [id])
  feeScheduleItem FeeScheduleItem? @relation(fields: [feeScheduleItemId], references: [id])

  insuranceClaimLines InsuranceClaimLine[]
  eraServiceLines     EraServiceLine[]

  createdAt DateTime @default(now())

  @@unique([chargeId, sequence])
  @@index([procedureCodeId])
}

model ChargeAdjustment {
  id         String @id @default(cuid())
  chargeId   String
  practiceId String
  patientId  String

  type   AdjustmentType
  status AdjustmentStatus @default(DRAFT)

  amount Decimal @db.Decimal(12, 2)
  reason String  @db.Text
  notes  String? @db.Text

  createdById  String
  reviewedById String?
  postedById   String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  postedAt   DateTime?
  voidedAt   DateTime?

  charge   Charge   @relation(fields: [chargeId], references: [id])
  practice Practice @relation(fields: [practiceId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  createdBy  User  @relation("AdjustmentCreator", fields: [createdById], references: [id])
  reviewedBy User? @relation("AdjustmentReviewer", fields: [reviewedById], references: [id])
  postedBy   User? @relation("AdjustmentPoster", fields: [postedById], references: [id])

  eraPostingItem   EraPostingItem? @relation("EraPostingItemAdjustments", fields: [eraPostingItemId], references: [id])
  eraPostingItemId String?

  reversalOfAdjustmentId String?           @unique
  reversalOfAdjustment   ChargeAdjustment? @relation("ChargeAdjustmentReversal", fields: [reversalOfAdjustmentId], references: [id], onDelete: Restrict)
  reversalAdjustment     ChargeAdjustment? @relation("ChargeAdjustmentReversal")

  eraPostingReversalId String?
  eraPostingReversal   EraPostingReversal? @relation("EraPostingReversalAdjustments", fields: [eraPostingReversalId], references: [id], onDelete: Restrict)

  @@index([practiceId, status, createdAt])
  @@index([chargeId, createdAt])
  @@index([patientId, createdAt])
}

model Payment {
  id         String @id @default(cuid())
  practiceId String
  patientId  String

  source PaymentSource
  method PaymentMethod
  status PaymentStatus @default(DRAFT)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD") @db.VarChar(3)

  referenceNumber String?
  receivedAt      DateTime
  notes           String?  @db.Text

  createdById  String
  reviewedById String?
  postedById   String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  postedAt   DateTime?
  voidedAt   DateTime?

  practice Practice @relation(fields: [practiceId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  createdBy  User  @relation("PaymentCreator", fields: [createdById], references: [id])
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  postedBy   User? @relation("PaymentPoster", fields: [postedById], references: [id])

  allocations     PaymentAllocation[]
  eraPostingClaim EraPostingClaim?

  reversalOfPaymentId String?  @unique
  reversalOfPayment   Payment? @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: Restrict)
  reversalPayment     Payment? @relation("PaymentReversal")

  eraPostingReversalId String?
  eraPostingReversal   EraPostingReversal? @relation("EraPostingReversalPayments", fields: [eraPostingReversalId], references: [id], onDelete: Restrict)

  @@index([practiceId, status, receivedAt])
  @@index([patientId, receivedAt])
  @@index([referenceNumber])
}

model PaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  chargeId  String

  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment        Payment         @relation(fields: [paymentId], references: [id])
  charge         Charge          @relation(fields: [chargeId], references: [id])
  eraPostingItem EraPostingItem?

  reversalOfAllocationId String?            @unique
  reversalOfAllocation   PaymentAllocation? @relation("PaymentAllocationReversal", fields: [reversalOfAllocationId], references: [id], onDelete: Restrict)
  reversalAllocation     PaymentAllocation? @relation("PaymentAllocationReversal")

  eraPostingReversalId String?
  eraPostingReversal   EraPostingReversal? @relation("EraPostingReversalAllocations", fields: [eraPostingReversalId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId, createdAt])
}

// -----------------------------------------------------------------------------
// Insurance payer and internal claim records
// These records support synthetic claim matching. They do not submit 837 claims.
// -----------------------------------------------------------------------------

model InsurancePayer {
  id         String   @id @default(cuid())
  practiceId String
  payerCode  String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  practice   Practice         @relation(fields: [practiceId], references: [id])
  claims     InsuranceClaim[]
  eraImports EraImport[]

  @@unique([practiceId, payerCode])
  @@index([practiceId, active, name])
}

model InsuranceClaim {
  id                      String               @id @default(cuid())
  practiceId              String
  patientId               String
  payerId                 String
  patientControlNumber    String
  payerClaimControlNumber String?
  status                  InsuranceClaimStatus @default(DRAFT)
  totalBilled             Decimal              @db.Decimal(12, 2)
  currency                String               @default("USD") @db.VarChar(3)
  submittedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  practice Practice       @relation(fields: [practiceId], references: [id])
  patient  Patient        @relation(fields: [patientId], references: [id])
  payer    InsurancePayer @relation(fields: [payerId], references: [id])

  lines            InsuranceClaimLine[]
  eraClaims        EraClaim[]
  eraPostingClaims EraPostingClaim[]

  @@unique([practiceId, patientControlNumber])
  @@index([practiceId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([payerId, payerClaimControlNumber])
}

model InsuranceClaimLine {
  id                 String    @id @default(cuid())
  claimId            String
  chargeLineId       String
  submittedAmount    Decimal   @db.Decimal(12, 2)
  units              Decimal?  @db.Decimal(10, 3)
  serviceDateFrom    DateTime?
  serviceDateThrough DateTime?
  createdAt          DateTime  @default(now())

  claim      InsuranceClaim @relation(fields: [claimId], references: [id])
  chargeLine ChargeLine     @relation(fields: [chargeLineId], references: [id])

  eraServiceLines EraServiceLine[]

  @@unique([claimId, chargeLineId])
  @@index([chargeLineId])
}

// -----------------------------------------------------------------------------
// 835 remittance import and reconciliation staging
// Raw source values are retained separately from posted financial transactions.
// -----------------------------------------------------------------------------

model EraImport {
  id         String          @id @default(cuid())
  practiceId String
  payerId    String?
  status     EraImportStatus @default(RECEIVED)

  fileName      String
  fileHash      String
  rawContent    String  @db.Text
  parserVersion String?

  interchangeControlNumber String?
  groupControlNumber       String?
  transactionControlNumber String?

  senderId   String?
  receiverId String?

  paymentAmount        Decimal?  @db.Decimal(12, 2)
  paymentMethodCode    String?
  paymentEffectiveDate DateTime?
  traceNumber          String?
  currency             String    @default("USD") @db.VarChar(3)

  importedById String
  receivedAt   DateTime  @default(now())
  validatedAt  DateTime?
  reconciledAt DateTime?
  postedAt     DateTime?
  notes        String?   @db.Text

  practice   Practice        @relation(fields: [practiceId], references: [id])
  payer      InsurancePayer? @relation(fields: [payerId], references: [id])
  importedBy User            @relation("EraImporter", fields: [importedById], references: [id])

  claims              EraClaim[]
  providerAdjustments EraProviderAdjustment[]
  exceptions          EraException[]
  postingBatch        EraPostingBatch?

  @@unique([practiceId, fileHash])
  @@index([practiceId, status, receivedAt])
  @@index([practiceId, traceNumber])
  @@index([interchangeControlNumber, groupControlNumber, transactionControlNumber])
}

model EraClaim {
  id               String  @id @default(cuid())
  eraImportId      String
  patientId        String?
  insuranceClaimId String?

  patientControlNumber    String
  payerClaimControlNumber String?
  claimStatusCode         String
  claimFilingIndicator    String?

  totalChargeAmount           Decimal @db.Decimal(12, 2)
  paymentAmount               Decimal @db.Decimal(12, 2)
  patientResponsibilityAmount Decimal @default(0) @db.Decimal(12, 2)

  claimReceivedDate     DateTime?
  claimStatementFrom    DateTime?
  claimStatementThrough DateTime?

  matchStatus EraMatchStatus @default(UNMATCHED)
  matchedAt   DateTime?
  notes       String?        @db.Text

  eraImport      EraImport       @relation(fields: [eraImportId], references: [id])
  patient        Patient?        @relation(fields: [patientId], references: [id])
  insuranceClaim InsuranceClaim? @relation(fields: [insuranceClaimId], references: [id])

  serviceLines EraServiceLine[]
  adjustments  EraAdjustment[]
  exceptions   EraException[]
  postingClaim EraPostingClaim?

  @@index([eraImportId, matchStatus])
  @@index([patientControlNumber])
  @@index([payerClaimControlNumber])
  @@index([insuranceClaimId])
}

model EraServiceLine {
  id         String @id @default(cuid())
  eraClaimId String

  insuranceClaimLineId String?
  chargeLineId         String?

  procedureIdentifierQualifier String?
  procedureCode                String?
  modifiers                    String[] @default([])
  revenueCode                  String?

  lineChargeAmount  Decimal  @db.Decimal(12, 2)
  linePaymentAmount Decimal  @db.Decimal(12, 2)
  unitsPaid         Decimal? @db.Decimal(10, 3)

  serviceDateFrom    DateTime?
  serviceDateThrough DateTime?

  serviceLineControlNumber String?
  adjudicationDate         DateTime?

  matchStatus EraMatchStatus @default(UNMATCHED)
  matchedAt   DateTime?

  eraClaim           EraClaim            @relation(fields: [eraClaimId], references: [id])
  insuranceClaimLine InsuranceClaimLine? @relation(fields: [insuranceClaimLineId], references: [id])
  chargeLine         ChargeLine?         @relation(fields: [chargeLineId], references: [id])

  adjustments   EraAdjustment[]
  exceptions    EraException[]
  postingItem   EraPostingItem? @relation(fields: [postingItemId], references: [id])
  postingItemId String?

  @@index([eraClaimId, matchStatus])
  @@index([procedureCode])
  @@index([chargeLineId])
}

model EraAdjustment {
  id String @id @default(cuid())

  eraClaimId       String
  eraServiceLineId String?

  adjustmentSequence Int
  groupCode          String
  reasonCode         String
  amount             Decimal  @db.Decimal(12, 2)
  quantity           Decimal? @db.Decimal(12, 3)

  eraClaim       EraClaim        @relation(fields: [eraClaimId], references: [id])
  eraServiceLine EraServiceLine? @relation(fields: [eraServiceLineId], references: [id])

  createdAt DateTime @default(now())

  @@unique([eraClaimId, adjustmentSequence])
  @@index([eraClaimId, groupCode, reasonCode])
  @@index([eraServiceLineId])
}

model EraProviderAdjustment {
  id String @id @default(cuid())

  eraImportId        String
  adjustmentSequence Int

  providerIdentifierQualifier String?
  providerIdentifier          String?
  fiscalPeriodDate            DateTime?
  reasonCode                  String
  referenceId                 String?
  amount                      Decimal   @db.Decimal(12, 2)

  eraImport EraImport @relation(fields: [eraImportId], references: [id])

  createdAt DateTime @default(now())

  @@unique([eraImportId, adjustmentSequence])
  @@index([eraImportId, reasonCode])
}

model EraException {
  id String @id @default(cuid())

  practiceId       String
  eraImportId      String
  eraClaimId       String?
  eraServiceLineId String?

  category String
  code     String?
  message  String  @db.Text

  severity EraExceptionSeverity @default(WARNING)
  status   EraExceptionStatus   @default(OPEN)

  resolutionNote String?   @db.Text
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practice       Practice        @relation(fields: [practiceId], references: [id])
  eraImport      EraImport       @relation(fields: [eraImportId], references: [id])
  eraClaim       EraClaim?       @relation(fields: [eraClaimId], references: [id])
  eraServiceLine EraServiceLine? @relation(fields: [eraServiceLineId], references: [id])
  resolvedBy     User?           @relation("EraExceptionResolver", fields: [resolvedById], references: [id])

  @@index([practiceId, status, severity, createdAt])
  @@index([eraImportId, status])
  @@index([eraClaimId])
  @@index([eraServiceLineId])
}

// -----------------------------------------------------------------------------
// ERA payment posting foundation
// These models stage and audit posting. They do not themselves post financials.
// -----------------------------------------------------------------------------

model EraPostingBatch {
  id          String @id @default(cuid())
  practiceId  String
  eraImportId String @unique

  status   EraPostingBatchStatus @default(PREVIEW)
  currency String                @default("USD") @db.VarChar(3)

  totalInsurancePayment       Decimal @default(0) @db.Decimal(12, 2)
  totalPatientResponsibility  Decimal @default(0) @db.Decimal(12, 2)
  totalContractualAdjustments Decimal @default(0) @db.Decimal(12, 2)

  preparedById String
  approvedById String?
  postedById   String?
  reversedById String?

  preparedAt DateTime  @default(now())
  approvedAt DateTime?
  postedAt   DateTime?
  reversedAt DateTime?

  reviewNote    String? @db.Text
  reversalNote  String? @db.Text
  blockingNotes String? @db.Text

  practice  Practice  @relation(fields: [practiceId], references: [id])
  eraImport EraImport @relation(fields: [eraImportId], references: [id])

  preparedBy User  @relation("EraPostingPreparer", fields: [preparedById], references: [id])
  approvedBy User? @relation("EraPostingApprover", fields: [approvedById], references: [id])
  postedBy   User? @relation("EraPostingPoster", fields: [postedById], references: [id])
  reversedBy User? @relation("EraPostingReverser", fields: [reversedById], references: [id])

  claims   EraPostingClaim[]
  reversal EraPostingReversal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, status, preparedAt])
}

// A completed reversal is recorded separately from the original posting.
// Reversal financial rows are compensating entries linked to their originals;
// original posted rows are retained for auditability.
model EraPostingReversal {
  id           String @id @default(cuid())
  batchId      String @unique
  practiceId   String
  reversedById String

  note      String   @db.Text
  createdAt DateTime @default(now())

  batch      EraPostingBatch @relation(fields: [batchId], references: [id])
  practice   Practice        @relation(fields: [practiceId], references: [id])
  reversedBy User            @relation("EraPostingReversalActor", fields: [reversedById], references: [id])

  reversalPayments    Payment[]           @relation("EraPostingReversalPayments")
  reversalAllocations PaymentAllocation[] @relation("EraPostingReversalAllocations")
  reversalAdjustments ChargeAdjustment[]  @relation("EraPostingReversalAdjustments")

  @@index([practiceId, createdAt])
}

// One ERA claim has one patient-level insurance payment. Its payment can be
// allocated across multiple charge-level posting items.
model EraPostingClaim {
  id               String  @id @default(cuid())
  batchId          String
  eraClaimId       String  @unique
  insuranceClaimId String?
  patientId        String?
  paymentId        String? @unique

  paymentAmount               Decimal @default(0) @db.Decimal(12, 2)
  patientResponsibilityAmount Decimal @default(0) @db.Decimal(12, 2)
  currency                    String  @default("USD") @db.VarChar(3)

  batch          EraPostingBatch @relation(fields: [batchId], references: [id])
  eraClaim       EraClaim        @relation(fields: [eraClaimId], references: [id])
  insuranceClaim InsuranceClaim? @relation(fields: [insuranceClaimId], references: [id])
  patient        Patient?        @relation(fields: [patientId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])

  items EraPostingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, eraClaimId])
  @@index([insuranceClaimId])
  @@index([patientId])
}

// One item represents the allocation to a matched charge. Multiple ERA service
// lines for the same charge can be linked to the same item.
model EraPostingItem {
  id                  String  @id @default(cuid())
  postingClaimId      String
  chargeId            String
  paymentAllocationId String? @unique

  chargeAmount          Decimal @default(0) @db.Decimal(12, 2)
  insurancePayment      Decimal @default(0) @db.Decimal(12, 2)
  patientResponsibility Decimal @default(0) @db.Decimal(12, 2)
  contractualAdjustment Decimal @default(0) @db.Decimal(12, 2)

  // Immutable snapshot of the adjustment codes, mapped treatments and amounts
  // used when this batch was prepared.
  adjustmentSnapshot Json?

  postingClaim      EraPostingClaim    @relation(fields: [postingClaimId], references: [id])
  charge            Charge             @relation(fields: [chargeId], references: [id])
  paymentAllocation PaymentAllocation? @relation(fields: [paymentAllocationId], references: [id])

  eraServiceLines EraServiceLine[]
  adjustments     ChargeAdjustment[] @relation("EraPostingItemAdjustments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postingClaimId, chargeId])
  @@index([chargeId])
}

model EraAdjustmentMapping {
  id         String @id @default(cuid())
  practiceId String

  groupCode   String
  reasonCode  String
  treatment   EraAdjustmentTreatment
  description String                 @db.Text
  active      Boolean                @default(true)

  practice Practice @relation(fields: [practiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceId, groupCode, reasonCode])
  @@index([practiceId, active, treatment])
}
